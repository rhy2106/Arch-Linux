#! /bin/bash

LIBPATH="$HOME/Documents/codigos"

cd "$LIBPATH"

ARQUIVO=$(basename $(fzf --preview 'bat --color=always {}' | cut -d '.' -f1))
echo $ARQUIVO
LISTANEGRA=(["cancel","Makefile","template.cpp"])
if [[ $LISTANEGRA =~ $ARQUIVO ]]; then
	echo "deleção cancelada"
else
	cd "$LIBPATH/src"
	rm "$ARQUIVO.cpp" 2> "/dev/null" \
		&& echo "// arquivo src/$ARQUIVO.cpp deletado com sucesso"
	cd "$LIBPATH/test"
	rm "$ARQUIVO" 2> "/dev/null" \
		&& echo "// arquivo test/$ARQUIVO deletado com sucesso"
	rm "$ARQUIVO.exp" 2> "/dev/null" \
		&& echo "// arquivo test/$ARQUIVO.exp deletado com sucesso"
	rm "$ARQUIVO.in" 2> "/dev/null" \
		&& echo "// arquivo test/$ARQUIVO.in deletado com sucesso"
	cd $LIBPATH
	cd "$LIBPATH/out"
	rm "$ARQUIVO" 2> "/dev/null" \
		&& echo "// arquivo out/$ARQUIVO deletado com sucesso"
fi
