#!/bin/bash

# Mostra as informações uma vez
clear
neofetch

# Pega a posição de onde vai começar a desenhar o ASCII (linha 2, coluna 60 por exemplo)
x=0
y=0

# Caminho dos frames
frames=(~/.config/neofetch/frames/*.txt)

# Loop de animação
while true; do
  for frame in "${frames[@]}"; do
    tput cup $x $y
    cat "$frame"
    sleep 0.03
  done
done

