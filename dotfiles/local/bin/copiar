#! /bin/bash

AGORAPATH="$PWD"
LIBPATH="/home/rafel/Documents/codigos/src"

cd $LIBPATH

ARQUIVO=$(fzf --preview 'bat --color=always {}')
#fzf --preview 'cat {}' | xargs -I {} cp "{}" $AGORAPATH
cd "$LIBPATH"
if [[ $ARQUIVO == *cancel* ]]; then
	echo "copia cancelada"
else
	sudo cp $ARQUIVO $AGORAPATH
fi

