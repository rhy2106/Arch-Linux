* {
	inv: #00000000;
	bg: #222222cc;
	fg1: #ffffff77;
	fg2: #dddddd77;
	tx: #000000;
	seltx: #0000dd;
	margin: 3px;
	scrollbar: true;

    color: @tx;
    font: "Terminess Nerd Font Mono 12";
}

#scrollbar {
	width:5px;
	handle-width: 5px;
	background-color: @fg1;
}

window {
	background-color: @bg;
	height: 350px;
    width: 450px;
	border-color: @fg2;
}

mainbox {
	background-color: @inv;
}

inputbar {
	background-color: @fg1;
	spacing: 5px;
	children: [entry];
}

entry {
	padding: 0px 5px 0px 5px;
	border-radius: 0px;
	background-color: @inv;
}

listview {
	background-color: @fg1;
}

message {
	background-color: @fg2;
}

element {
	background-color: @fg2;
	children: [element-icon, element-text];
}

element selected {
	background-color: @fg1;
}

element-text, element-icon {
	background-color: @inv;
}
element-text selected {
	color:@seltx;
}
