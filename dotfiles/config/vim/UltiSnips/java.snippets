snippet "get (\w+) (\w+)" "get" r
public `!p snip.rv = match.group(2)` get${1:`!p snip.rv = match.group(1)`}(){
	return `!p snip.rv = match.group(1)`;
}
endsnippet

snippet "class" "class" r
public class $1{
	$2
}
endsnippet

snippet "sout" "sout" r
System.out.println(${1});
endsnippet

snippet "main" "main" r
public static void main(String args[]){
	$1
}
endsnippet

